# ==============================================================================
# AHRAS (Adaptive Hybrid Risk-Aware Security Framework) Environment Config
# ==============================================================================

# Runtime Environment: DEV | STAGING | PRODUCTION
AHRAS_ENV=DEV
AHRAS_DEV_MODE=true

# Security & Authentication (MANDATORY IN PRODUCTION: min 32 chars, high entropy)
# In PRODUCTION, server will FAIL CLOSED if using default/weak secret.
AHRAS_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key-in-production
AHRAS_TOKEN_EXPIRE_MINUTES=480
AHRAS_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Network & API Hardening
AHRAS_HOST=0.0.0.0
AHRAS_PORT=8000
AHRAS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AHRAS_RATE_LIMIT_PER_MINUTE=120
AHRAS_MAX_REQUEST_BYTES=2097152

# Active Defense Response Execution Mode: DRY_RUN | SIMULATED | SANDBOX | REAL_PRODUCTION
AHRAS_RESPONSE_MODE=DRY_RUN

# Storage Configuration
SQLITE_PATH=ahras/logs/ahras_dev.db
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ahras

# Message Bus (Kafka in Production)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_RAW=raw.telemetry
KAFKA_TOPIC_NORM=normalized.events

# Threat Intelligence (Optional External Feed Keys)
ABUSEIPDB_KEY=
OTX_API_KEY=

# ML & Detection Settings
AHRAS_MODEL_DIR=ahras/detection/models
IF_CONTAMINATION=0.05
SVM_NU=0.02
AE_ERROR_PCTILE=97.0
ENSEMBLE_THRESH=0.75
